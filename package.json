{
  "name": "sportbook",
  "version": "1.0.0",
  "description": "Кроссплатформенное приложение для бронирования муниципальных спортивных площадок образовательными учреждениями",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "test:db": "node db/test_db.js",
    "photos:check": "node scripts/check-photos.js",
    "photos:scan": "node scripts/scan-photos.js",
    "photos:generate": "node scripts/generate-venue-images.js"
  },
  "keywords": [
    "sport",
    "booking",
    "municipal",
    "education",
    "express",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  }
}
