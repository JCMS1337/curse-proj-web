# Настройки веб-сервера
PORT=3000

# Подключение приложения к базе данных PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sport_booking
DB_USER=sport_booking_user
DB_PASSWORD=your_secure_password_here

# Секрет и параметры для JWT-токенов
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Параметры суперпользователя Postgres для миграций (при необходимости)
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=your_postgres_superuser_password
PG_BIN_PATH=D:\posgre\bin
